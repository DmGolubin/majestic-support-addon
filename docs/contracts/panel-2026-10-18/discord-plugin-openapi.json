  "components": {
    "securitySchemes": {
      "PluginBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ]
      },
      "DeviceStart": {
        "type": "object",
        "properties": {
          "client_id": {
            "const": "support-templates"
          },
          "device_name": {
            "type": "string",
            "maxLength": 80
          },
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "client_id"
        ]
      },
      "DevicePending": {
        "type": "object",
        "properties": {
          "device_code": {
            "type": "string"
          },
          "user_code": {
            "type": "string"
          },
          "verification_uri": {
            "type": "string",
            "format": "uri"
          },
          "verification_uri_complete": {
            "type": "string",
            "format": "uri"
          },
          "expires_in": {
            "type": "integer"
          },
          "interval": {
            "type": "integer"
          }
        },
        "required": [
          "device_code",
          "user_code",
          "verification_uri",
          "expires_in",
          "interval"
        ]
      },
      "TokenRequest": {
        "type": "object",
        "properties": {
          "client_id": {
            "const": "support-templates"
          },
          "grant_type": {
            "enum": [
              "urn:ietf:params:oauth:grant-type:device_code",
              "refresh_token"
            ]
          },
          "device_code": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "client_id",
          "grant_type"
        ]
      },
      "Tokens": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer"
          },
          "scope": {
            "type": "string"
          },
          "connectionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in",
          "scope",
          "connectionId"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "connectionId": {
            "type": "string",
            "format": "uuid"
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissionsRevision": {
            "type": "string"
          },
          "schemaVersion": {
            "type": "integer"
          },
          "minimumPluginVersion": {
            "type": "string"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": []
      },
      "PersonalInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "text": {
            "type": "string",
            "maxLength": 20000
          },
          "project": {
            "enum": [
              "majestic",
              "russia-online"
            ]
          },
          "shared": {
            "type": "boolean"
          },
          "command": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "folderId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "PersonalCreate": {
        "type": "object",
        "properties": {
